<section class="rosd-block rosd-list">
  <h2>Spells <small>(one action, one spell per activation, not in combat)</small></h2>
  <ol>
    {{#each spells}}
    <li class="{{#if used}}used{{/if}}">
      <div class="rosd-list-row">
        <input type="checkbox" data-action="toggleUsed" data-list="spells" data-index="{{i}}" {{checked used}} data-tooltip="Cast this scenario">
        <a class="rosd-icon" data-action="editIcon" data-list="spells" data-index="{{i}}" data-tooltip="Click: change icon (PNG/JPEG) · Right click: default icon">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-wand-sparkles"></i>{{/if}}</a>
        <a class="rosd-list-name" data-action="describe" data-list="spells" data-index="{{i}}" data-tooltip="Post to chat">{{label}}</a>
        {{#if tag}}<span class="rosd-tag">{{tag}}</span>{{/if}}
        <span class="rosd-en">{{en}}</span>
        {{#if ../editable}}
        <button type="button" data-action="cast" data-index="{{i}}"><i class="fa-solid fa-wand-sparkles"></i> Cast</button>
        <a class="rosd-remove" data-action="remove" data-list="spells" data-index="{{i}}" data-tooltip="Remove"><i class="fa-solid fa-xmark"></i></a>
        {{/if}}
      </div>
      <p class="rosd-desc">{{desc}}</p>
    </li>
    {{else}}
    <li class="rosd-empty">No spells known.</li>
    {{/each}}
  </ol>
  {{#if editable}}
  <select data-add="spells"><option value="">+ Add a spell…</option>{{selectOptions spellChoices}}</select>
  {{/if}}
  {{#if (eq actor.type "ranger")}}
  <label class="rosd-inline rosd-caster">Objet de lanceur de sorts
    <select name="system.casterItem">{{selectOptions casterChoices selected=system.casterItem}}</select></label>
  {{/if}}
  <p class="rosd-hint">Target the affected figures before casting: resistance rolls, healing and magic attacks use them.</p>
</section>
