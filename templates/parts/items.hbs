<section class="rosd-block rosd-items">
  <h2>Items <small>(drag and drop an item onto the sheet)</small></h2>
  {{#if itemsList.length}}
  <ol class="rosd-item-list">
    {{#each itemsList}}
    <li class="rosd-item{{#unless equipped}} unequipped{{/unless}}" data-item-id="{{id}}" draggable="true">
      <img src="{{img}}" alt="">
      <div class="rosd-item-main">
        <a class="rosd-item-name" data-action="itemEdit">{{name}}</a>
        <div class="rosd-item-sub">
          {{category}}{{#if weaponInfo}} · {{weaponInfo}}{{/if}}{{#if bonus}} · <b>{{bonus}}</b>{{/if}}
          {{#if charges}} · charges {{charges}}{{/if}}{{#if active}} · <span class="rosd-active">active</span>{{/if}}
          {{#if magic}} · <span class="rosd-active">magic</span>{{/if}}
        </div>
      </div>
      <span class="rosd-item-num" data-tooltip="Quantity">×{{quantity}}</span>
      <span class="rosd-item-num" data-tooltip="Item slots">{{slots}} empl.</span>
      {{#if ../editable}}
      {{#if isWeapon}}<a data-action="itemWield" class="{{#if wielded}}on{{/if}}" data-tooltip="{{#if wielded}}Wielded (click to stow){{else}}Wield{{/if}}"><i class="fa-solid fa-hand-fist"></i></a>
      {{else}}<a data-action="itemEquip" class="{{#if equipped}}on{{/if}}" data-tooltip="{{#if equipped}}Worn: bonuses applied (click to remove){{else}}Stowed: bonuses not applied{{/if}}"><i class="fa-solid fa-shirt"></i></a>{{/if}}
      {{#if usable}}<a data-action="itemUse" data-tooltip="{{useLabel}}"><i class="fa-solid fa-wand-magic"></i></a>{{/if}}
      <a data-action="itemChat" data-tooltip="Post to chat"><i class="fa-solid fa-comment"></i></a>
      <a class="rosd-remove" data-action="itemDelete" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="rosd-drop-hint"><i class="fa-solid fa-hand-pointer"></i> Drag an item here from the Items tab, a compendium or another sheet.</p>
  {{/if}}
  {{#if slotInfo}}<p class="rosd-hint{{#if slotInfo.over}} rosd-warn{{/if}}">{{slotInfo.text}}</p>{{/if}}
  <p class="rosd-hint">Bonuses from worn armour and items, and from the wielded weapon, are added to the stats (“Items” line). A dropped weapon is wielded automatically.</p>
</section>
