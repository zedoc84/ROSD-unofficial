<section class="rosd-block rosd-status">
  <h2>Status</h2>
  <label class="rosd-check"><input type="checkbox" name="system.status.poisoned" {{checked system.status.poisoned}}> Poisoned <small>(one action per activation)</small></label>
  <label class="rosd-check"><input type="checkbox" name="system.status.diseased" {{checked system.status.diseased}}> Diseased <small>(-1 to all rolls)</small></label>
  <label class="rosd-inline">Faim et soif <input type="number" min="0" name="system.status.hunger" value="{{system.status.hunger}}"> <small>level(s), -2 Health each</small></label>
</section>
