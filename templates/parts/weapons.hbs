<section class="rosd-block rosd-weapons">
  <h2>Weapons &amp; Combat</h2>
  <div class="rosd-attack-buttons">
    <button type="button" data-action="melee"><i class="fa-solid fa-khanda"></i> Melee <b>{{fightLabel}}</b></button>
    <button type="button" data-action="shoot"><i class="fa-solid fa-bullseye"></i> Shoot <b>{{shootLabel}}</b></button>
  </div>
  <p class="rosd-hint">Target your opponent (press T on its token) before rolling: its stats are used automatically.</p>
  <div class="rosd-form-grid">
    <label>Arme de mêlée
      <select name="system.weapons.melee">{{selectOptions meleeChoices selected=system.weapons.melee}}</select></label>
    <label>Arme de tir
      <select name="system.weapons.ranged">{{selectOptions rangedChoices selected=system.weapons.ranged}}</select></label>
    {{#if (eq system.weapons.ranged "other")}}
    <label>Damage (“Other” missile)<input type="number" name="system.weapons.rangedDmg" value="{{system.weapons.rangedDmg}}"></label>
    <label>Range (")<input type="number" name="system.weapons.rangedRange" value="{{system.weapons.rangedRange}}"></label>
    {{/if}}
    <label>Fight bonus (magic weapon…)<input type="number" name="system.weapons.fightBonus" value="{{system.weapons.fightBonus}}"></label>
    <label>Shoot bonus<input type="number" name="system.weapons.shootBonus" value="{{system.weapons.shootBonus}}"></label>
    <label>Melee damage bonus<input type="number" name="system.weapons.dmgBonus" value="{{system.weapons.dmgBonus}}"></label>
    <label>Damage multiplier<input type="number" min="1" name="system.weapons.mult" value="{{system.weapons.mult}}"></label>
    <label class="rosd-check"><input type="checkbox" name="system.weapons.magic" {{checked system.weapons.magic}}> Arme magique</label>
  </div>
</section>
