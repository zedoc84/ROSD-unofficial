<section class="rosd-block rosd-list">
  <h2>Heroic Abilities <small>(once per scenario, one per activation)</small></h2>
  <ol>
    {{#each abilities}}
    <li class="{{#if used}}used{{/if}}">
      <div class="rosd-list-row">
        <input type="checkbox" data-action="toggleUsed" data-list="abilities" data-index="{{i}}" {{checked used}} data-tooltip="Used this scenario">
        <a class="rosd-icon" data-action="editIcon" data-list="abilities" data-index="{{i}}" data-tooltip="Click: change icon (PNG/JPEG) · Right click: default icon">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-star"></i>{{/if}}</a>
        <a class="rosd-list-name" data-action="describe" data-list="abilities" data-index="{{i}}" data-tooltip="Post to chat">{{label}}</a>
        <span class="rosd-en">{{en}}</span>
        {{#if ../editable}}
        <button type="button" data-action="ability" data-index="{{i}}"><i class="fa-solid fa-star"></i> Use</button>
        <a class="rosd-remove" data-action="remove" data-list="abilities" data-index="{{i}}" data-tooltip="Remove"><i class="fa-solid fa-xmark"></i></a>
        {{/if}}
      </div>
      <p class="rosd-desc">{{desc}}</p>
    </li>
    {{else}}
    <li class="rosd-empty">No Heroic Abilities yet — pick one below.</li>
    {{/each}}
  </ol>
  {{#if editable}}
  <select data-add="abilities"><option value="">+ Add a Heroic Ability…</option>{{selectOptions abilityChoices}}</select>
  {{/if}}
</section>
