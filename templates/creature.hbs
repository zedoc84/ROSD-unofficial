<div class="rosd-sheet">
  <header class="rosd-header">
    <img class="rosd-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="portrait" data-tooltip="Change portrait">
    <div class="rosd-ident">
      <input class="rosd-name" type="text" name="name" value="{{actor.name}}" placeholder="Creature name">
      <div class="rosd-ident-row">
        <label>Bestiaire
          <select data-profile><option value="">— Choose —</option>{{{profileOptions}}}</select></label>
        <button type="button" data-action="applyProfile"><i class="fa-solid fa-file-import"></i> Apply</button>
        <label class="short">XP<input type="number" name="system.xp" value="{{system.xp}}"></label>
      </div>
      <div class="rosd-quick">
        <button type="button" data-action="melee"><i class="fa-solid fa-khanda"></i> Melee {{fightLabel}}</button>
        <button type="button" data-action="shoot"><i class="fa-solid fa-bullseye"></i> Shoot {{shootLabel}}</button>
        <button type="button" data-action="rollStat" data-key="will"><i class="fa-solid fa-brain"></i> Will</button>
      </div>
    </div>
    {{> "systems/rosd/templates/parts/emblem.hbs"}}
  </header>

  <div class="rosd-body">
    {{> "systems/rosd/templates/parts/stats.hbs"}}
    <div class="rosd-columns">
      <section class="rosd-block">
        <h2>Traits</h2>
        <div class="rosd-flags">
          <label class="rosd-check"><input type="checkbox" name="system.flags.undead" {{checked system.flags.undead}}> Undead</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.animal" {{checked system.flags.animal}}> Animal</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.large" {{checked system.flags.large}}> Large</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.flying" {{checked system.flags.flying}}> Flying</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.poison" {{checked system.flags.poison}}> Poison</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.partialImmunity" {{checked system.flags.partialImmunity}}> Partial immunity</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.immuneCrit" {{checked system.flags.immuneCrit}}> Immune to criticals</label>
          <label class="rosd-check"><input type="checkbox" name="system.flags.spellcaster" {{checked system.flags.spellcaster}}> Spellcaster</label>
          <label class="rosd-inline">Disease (TN)<input type="number" min="0" name="system.flags.disease" value="{{system.flags.disease}}"></label>
          <label class="rosd-inline">Horrific (TN)<input type="number" min="0" name="system.flags.horrific" value="{{system.flags.horrific}}"></label>
        </div>
        <label class="rosd-wide">Profile notes<textarea name="system.traits" rows="3">{{system.traits}}</textarea></label>
      </section>
      <section class="rosd-block">
        <h2>Special Rules</h2>
        <textarea name="system.special" rows="5" placeholder="Special actions, spells, scenario behaviour…">{{system.special}}</textarea>
        <details class="rosd-ai"><summary>Creature Behaviour</summary>{{{aiText}}}</details>
      </section>
    </div>
    {{> "systems/rosd/templates/parts/weapons.hbs"}}
    {{> "systems/rosd/templates/parts/items.hbs"}}
    <section class="rosd-block">
      <h2>Notes</h2>
      <textarea name="system.notes" rows="4">{{system.notes}}</textarea>
    </section>
  </div>
</div>
