<div class="rosd-sheet">
  <header class="rosd-header">
    <img class="rosd-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="portrait" data-tooltip="Changer le portrait">
    <div class="rosd-ident">
      <input class="rosd-name" type="text" name="name" value="{{actor.name}}" placeholder="Nom du ranger">
      <div class="rosd-ident-row">
        <label>Joueur<input type="text" name="system.player" value="{{system.player}}"></label>
        <label class="short">Niveau<input type="number" name="system.level" value="{{system.level}}"></label>
        <label class="short">PX<input type="number" name="system.xp" value="{{system.xp}}"></label>
        <span class="rosd-next" data-tooltip="{{system.nextLevelBonus}}">Niv. {{rosdAdd system.level 1}} : {{system.nextLevelCost}} PX
          {{#if canLevel}}<button type="button" data-action="levelUp"><i class="fa-solid fa-arrow-up"></i> Monter</button>{{/if}}</span>
      </div>
      <div class="rosd-quick">
        <button type="button" data-action="melee"><i class="fa-solid fa-khanda"></i> Mêlée {{fightLabel}}</button>
        <button type="button" data-action="shoot"><i class="fa-solid fa-bullseye"></i> Tir {{shootLabel}}</button>
        <button type="button" data-action="newScenario" data-tooltip="Réinitialise capacités, sorts et poison"><i class="fa-solid fa-rotate"></i> Nouveau scénario</button>
        <button type="button" data-action="survival" data-tooltip="Après la partie, si la Santé est tombée à 0"><i class="fa-solid fa-skull-crossbones"></i> Survie</button>
      </div>
    </div>
    {{> "systems/rosd/templates/parts/emblem.hbs"}}
  </header>

  <nav class="rosd-tabs">
    <a data-action="rosdTab" data-tab-link="main">Fiche</a>
    <a data-action="rosdTab" data-tab-link="powers">Capacités &amp; sorts</a>
    <a data-action="rosdTab" data-tab-link="gear">Équipement</a>
    <a data-action="rosdTab" data-tab-link="campaign">Campagne &amp; notes</a>
  </nav>

  <div class="rosd-body">
    <section class="rosd-panel" data-tab-panel="main">
      {{> "systems/rosd/templates/parts/stats.hbs"}}
      <div class="rosd-columns">
        {{> "systems/rosd/templates/parts/skills.hbs"}}
        <div>
          {{> "systems/rosd/templates/parts/status.hbs"}}
          <section class="rosd-block">
            <h2>Blessures permanentes</h2>
            <textarea name="system.injuries" rows="4" placeholder="Ex. : Bras broyé (Combat +3/+2)">{{system.injuries}}</textarea>
          </section>
        </div>
      </div>
    </section>

    <section class="rosd-panel" data-tab-panel="powers">
      {{> "systems/rosd/templates/parts/abilities.hbs"}}
      {{> "systems/rosd/templates/parts/spells.hbs"}}
    </section>

    <section class="rosd-panel" data-tab-panel="gear">
      {{> "systems/rosd/templates/parts/weapons.hbs"}}
      {{> "systems/rosd/templates/parts/items.hbs"}}
      <section class="rosd-block rosd-slots">
        <h2>Emplacements d'objets <small>(6)</small></h2>
        <datalist id="rosd-equip-{{actor.id}}">{{#each equipmentList}}<option value="{{this}}"></option>{{/each}}</datalist>
        <ol>
          <li><input type="text" list="rosd-equip-{{actor.id}}" name="system.gear.slot1" value="{{system.gear.slot1}}"></li>
          <li><input type="text" list="rosd-equip-{{actor.id}}" name="system.gear.slot2" value="{{system.gear.slot2}}"></li>
          <li><input type="text" list="rosd-equip-{{actor.id}}" name="system.gear.slot3" value="{{system.gear.slot3}}"></li>
          <li><input type="text" list="rosd-equip-{{actor.id}}" name="system.gear.slot4" value="{{system.gear.slot4}}"></li>
          <li><input type="text" list="rosd-equip-{{actor.id}}" name="system.gear.slot5" value="{{system.gear.slot5}}"></li>
          <li><input type="text" list="rosd-equip-{{actor.id}}" name="system.gear.slot6" value="{{system.gear.slot6}}"></li>
        </ol>
        <div class="rosd-form-grid">
          <label>Dague / couteau gratuit<input type="text" name="system.gear.freeKnife" value="{{system.gear.freeKnife}}"></label>
          <label>Munition magique (carquois)<input type="text" name="system.gear.magicAmmo" value="{{system.gear.magicAmmo}}"></label>
        </div>
        <label class="rosd-wide">Objets magiques personnels
          <textarea name="system.gear.personalMagic" rows="3">{{system.gear.personalMagic}}</textarea></label>
        <label class="rosd-wide">Trésors sécurisés
          <textarea name="system.treasure" rows="3">{{system.treasure}}</textarea></label>
      </section>
    </section>

    <section class="rosd-panel" data-tab-panel="campaign">
      <section class="rosd-block rosd-recruit">
        <h2>Recrutement</h2>
        <div class="rosd-form-grid">
          <label>Points de recrutement de base<input type="number" name="system.brp" value="{{system.brp}}"></label>
          <div class="rosd-readout"><span>{{recruit.total}}</span> PR totaux pour {{recruit.players}} joueur(s), Commandement inclus</div>
          <div class="rosd-readout"><span>{{recruit.max}}</span> compagnons max · <span>{{recruit.activate}}</span> activés en phase des Rangers</div>
        </div>
        <label class="rosd-wide">Compagnons actuels
          <textarea name="system.companions" rows="3">{{system.companions}}</textarea></label>
      </section>
      <section class="rosd-block">
        <h2>Création et progression</h2>
        <p class="rosd-hint">Prochain niveau ({{rosdAdd system.level 1}}) : {{system.nextLevelBonus}}.</p>
        <label class="rosd-wide">Points de construction dépensés
          <textarea name="system.buildPoints" rows="3" placeholder="10 PC : caractéristiques (3 max), capacités/sorts (5 max), compétences (5 max, 8 × +1 chacun), recrutement (3 max, +10 PR)">{{system.buildPoints}}</textarea></label>
        <label class="rosd-wide">Historique
          <textarea name="system.background" rows="4">{{system.background}}</textarea></label>
        <label class="rosd-wide">Notes
          <textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
      </section>
    </section>
  </div>
</div>
